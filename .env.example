# Environment configuration
NODE_ENV=production
PORT=4000

# Database (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smartstock?retryWrites=true&w=majority

# JWT Secrets (minimum 32 characters each)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long

# Frontend URL (CORS & Socket.IO allowed origins, comma separated if multiple)
CLIENT_URL=https://smartstock-web.vercel.app
CORS_ORIGIN=https://smartstock-web.vercel.app

# Optional: Cloudinary for cloud image storage (recommended for Render's ephemeral disk)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Optional: Resend for password reset emails
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
